# Copy this file to .env and adjust as needed, then `docker compose up -d --build`.

NEWSPAPERS=the-new-york-times,the-washington-post,usa-today,financial-times,the-herald-scotland,the-irish-times,new-york-post,chicago-tribune
UPDATE_TIMES=07:00,13:00,19:00
TZ=Europe/London
KINDLE_WIDTH=1264
KINDLE_HEIGHT=1680
IMAGE_FIT=contain
BACKGROUND=white
CONTRAST=1.15
SHARPEN=true
PORT=8080
HOST_PORT=8080
MAX_ATTEMPTS_PER_CYCLE=3
FETCH_ON_STARTUP=true
LOG_LEVEL=INFO
