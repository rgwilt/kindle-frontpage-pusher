# Copy this file to .env and adjust as needed, then `docker compose up -d --build`.

# Comma-separated "Name|https://feed-url" pairs. Add/remove/replace feeds
# freely -- any standard RSS/Atom feed works. A feed failing to fetch just
# gets skipped for that cycle; the digest renders from whatever succeeded.
RSS_FEEDS=BBC News|http://feeds.bbci.co.uk/news/rss.xml,BBC World|https://feeds.bbci.co.uk/news/world/rss.xml,Sky News|https://feeds.skynews.com/feeds/rss/home.xml,NPR|https://feeds.npr.org/1001/rss.xml

# Headlines pulled from each feed, and the overall cap after round-robin
# interleaving across sources. The layout engine drops whatever doesn't
# physically fit on the page, so TOTAL_HEADLINES can comfortably exceed
# what actually renders (it's a pool to choose from, not a hard target).
HEADLINES_PER_FEED=5
TOTAL_HEADLINES=18

# Masthead title shown at the top of the rendered page.
PAPER_NAME=THE KINDLE TIMES

# 24h HH:MM times (in TZ below) at which to refresh the digest. Add/remove
# entries to change how often it updates.
UPDATE_TIMES=07:00,13:00,19:00

# Timezone for UPDATE_TIMES and for scheduling logic in general.
TZ=Europe/London

# Kindle Paperwhite (2024): 7", 1264x1680 px, 300 ppi, E Ink Carta 1300.
KINDLE_WIDTH=1264
KINDLE_HEIGHT=1680

PORT=8080

# Port exposed on the Docker host (change if 8080 is already taken).
HOST_PORT=8787

FETCH_ON_STARTUP=true
LOG_LEVEL=INFO
